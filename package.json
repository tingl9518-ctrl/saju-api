{
  "name": "saju-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test tests/*.test.mjs",
    "build:data:lunarjs": "node scripts/build-solar-terms.mjs --out app/api/saju/data/solar-terms/bundle.lunarjs.json",
    "build:data:domestic": "node scripts/merge-jieqi-reference-lichun.mjs --seed app/api/saju/data/solar-terms/bundle.lunarjs.json --csv reference/jieqi-reference.csv --out app/api/saju/data/solar-terms/bundle.json",
    "build:data": "npm run build:data:lunarjs && npm run build:data:domestic",
    "qa:jieqi": "node scripts/compare-jieqi-reference.mjs",
    "qa:jieqi:report": "node scripts/report-jieqi-lichun-diff.mjs",
    "qa:jieqi:report:12jie": "node scripts/report-jieqi-12jie-diff.mjs",
    "export:jieqi-baseline": "node scripts/export-jieqi-baseline.mjs",
    "qa:jieqi:coverage": "node scripts/report-jieqi-coverage.mjs",
    "qa:jieqi:lichun-priority": "node scripts/report-jieqi-lichun-priority.mjs",
    "export:lichun-qa-queue": "node scripts/export-lichun-human-qa-queue.mjs"
  },
  "dependencies": {
    "manseryeok": "^1.0.1",
    "next": "16.2.6",
    "openai": "^6.37.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "lunar-javascript": "^1.7.7",
    "typescript": "^5"
  }
}
